# Variáveis do docker compose. Local: opcional. VPS: copie para .env e preencha tudo.
DOMAIN=store.petvilaclub.com.br
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
# localhost é obrigatório: o healthcheck do compose chama http://localhost:8000/api/health/.
DJANGO_ALLOWED_HOSTS=store.petvilaclub.com.br,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://store.petvilaclub.com.br
CORS_ALLOWED_ORIGINS=https://store.petvilaclub.com.br
FRONTEND_URL=https://store.petvilaclub.com.br
POSTGRES_DB=petvila
POSTGRES_USER=petvila
POSTGRES_PASSWORD=
# Asaas (produção: ASAAS_ENV=production). O token é o mesmo cadastrado no webhook do painel Asaas.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
SEED_DEMO=0
