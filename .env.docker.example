# Variáveis do docker compose. Local: opcional. VPS: copie para .env e preencha tudo.
DOMAIN=loja.petvilaclub.com.br
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=loja.petvilaclub.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://loja.petvilaclub.com.br
CORS_ALLOWED_ORIGINS=https://loja.petvilaclub.com.br
FRONTEND_URL=https://loja.petvilaclub.com.br
POSTGRES_DB=petvila
POSTGRES_USER=petvila
POSTGRES_PASSWORD=
# Asaas (produção: ASAAS_ENV=production). O token é o mesmo cadastrado no webhook do painel Asaas.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
SEED_DEMO=0
