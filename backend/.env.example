# Copie para backend/.env (ou use o .env da raiz com o docker compose). Nunca commite valores reais.
DJANGO_DEBUG=1
# Obrigatório em produção: string longa e aleatória (python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
DATABASE_URL=postgres://petvila:petvila@localhost:5432/petvila
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081
FRONTEND_URL=http://localhost:8080

# Asaas: vazio = provedor simulado (só em desenvolvimento).
# Sandbox: crie a conta em https://sandbox.asaas.com e gere a chave em Integrações.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Mesmo token configurado no webhook do painel Asaas (header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=dev-webhook-token
